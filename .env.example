# ==============================================================================
# NEON SERVERLESS POSTGRESQL CONFIGURATION
# ==============================================================================

# 1. POOLED CONNECTION (Used by serverless API routes & @neondatabase/serverless)
# Uses Neon's built-in PgBouncer pooler (endpoint contains '-pooler')
POOLED_DATABASE_URL="postgresql://neondb_owner:npg_password@ep-cool-forest-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. DIRECT CONNECTION (Used by migrations & DDL schema pushes via Drizzle Kit)
# Direct connection to the compute node without PgBouncer (no '-pooler' in endpoint)
DIRECT_DATABASE_URL="postgresql://neondb_owner:npg_password@ep-cool-forest-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# AUTHENTICATION & JWT SECURITY
# ==============================================================================
JWT_SECRET="antigravity-neon-jwt-super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ==============================================================================
# APPLICATION PORTS
# ==============================================================================
PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3000"
